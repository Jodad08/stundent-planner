    "evals": "tsx evals/run_evals.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@xyflow/react": "^12.12.0",
    "express": "^5.2.1",
