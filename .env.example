# Copy to .env. Never commit .env.
GEMINI_API_KEY=
# Checked against the live model list (GET /v1beta/models) on 2026-10-02
GEMINI_MODEL=gemini-3.8-flash
# gemini | mock  (default: gemini when GEMINI_API_KEY is set, else mock)
AI_PROVIDER=
PORT=3000
GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-2.5-flash
